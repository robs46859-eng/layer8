{
  "name": "salti8-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@salti8/web",
    "build": "npm run build --workspace=@salti8/web",
    "start": "npm run start --workspace=@salti8/web",
    "check": "npm run check --workspace=@salti8/web"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
