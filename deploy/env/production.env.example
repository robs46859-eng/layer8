APP_NAME=enterprise-ai-routing-proxy
ENVIRONMENT=production
BACKEND_MODE=self_hosted
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg://proxy_user:change-me@prod-postgres.example.internal:5432/ai_proxy
REDIS_URL=redis://prod-redis.example.internal:6379/0

S3_BUCKET=ai-proxy-audit-production
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AUDIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ai-proxy-audit-production

DEFAULT_PROVIDER=openai
OPENAI_API_KEY=change-me
ENABLE_PROMPT_LOGGING=false

RATE_LIMIT_REQUESTS_PER_MINUTE=240
PLUGIN_TIMEOUT_MS=100
CACHE_TTL_SECONDS=300
CACHE_S3_THRESHOLD_BYTES=4096

WORKER_POLL_SECONDS=3
WORKER_BATCH_SIZE=10

STARTUP_CHECKS_ENABLED=true
STARTUP_CHECKS_STRICT=true
