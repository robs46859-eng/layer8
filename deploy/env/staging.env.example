APP_NAME=enterprise-ai-routing-proxy
ENVIRONMENT=staging
BACKEND_MODE=self_hosted
HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg://proxy_user:change-me@staging-postgres.example.internal:5432/ai_proxy
REDIS_URL=redis://staging-redis.example.internal:6379/0

S3_BUCKET=ai-proxy-audit-staging
S3_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AUDIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ai-proxy-audit-staging

DEFAULT_PROVIDER=mock
OPENAI_API_KEY=change-me
ENABLE_PROMPT_LOGGING=false

RATE_LIMIT_REQUESTS_PER_MINUTE=60
PLUGIN_TIMEOUT_MS=100
CACHE_TTL_SECONDS=120
CACHE_S3_THRESHOLD_BYTES=4096

WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=5

STARTUP_CHECKS_ENABLED=true
STARTUP_CHECKS_STRICT=true
