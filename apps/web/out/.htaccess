# ---------------------------------------------------------------------------
# SALTI8 static export — Hostinger (LiteSpeed/Apache) server configuration
#
# This file is committed under apps/web/public/ so `next build` copies it
# verbatim into apps/web/out/, which is the directory Hostinger publishes.
#
# Responsibilities, in order of SEO impact:
#   1. One canonical origin  (https + apex, no www)
#   2. A real 404 status for unknown routes
#   3. Correct MIME types so .webp / .webmanifest are not served as octet-stream
#   4. Long-lived immutable caching for hashed build assets
#   5. Baseline security headers
#
# Do not add application secrets here. This file is publicly readable content
# in the deployed artifact.
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1a. Force HTTPS -----------------------------------------------------
  # Two conditions so the rule works both when TLS terminates at the vhost and
  # when it terminates at an upstream proxy/CDN.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- 1b. Force the apex host (drop www) ----------------------------------
  # salti8.com is the canonical host emitted by every <link rel="canonical">
  # and every sitemap entry. www must 301 to it, not serve a duplicate copy.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # --- 1c. Enforce the trailing slash --------------------------------------
  # The export uses `trailingSlash: true`. /ai-gateway and /ai-gateway/ must not
  # both resolve, or Google sees two URLs for one page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --- 2. Error document ------------------------------------------------------
# next build emits out/404.html from app/not-found.tsx.
ErrorDocument 404 /404.html

# --- 3. MIME types ----------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType image/avif                 .avif
  AddType image/svg+xml              .svg
  AddType application/manifest+json  .webmanifest
  AddType application/json           .json
  AddType text/xml                   .xml
  AddType font/woff2                 .woff2
</IfModule>

# --- 4. Caching -------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  # HTML must stay short so a deploy is visible immediately.
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Content-addressed build output is safe to cache forever.
  <FilesMatch "^.*\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^.*\.(webp|avif|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml|manifest\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # --- 5. Security headers --------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
</IfModule>

# --- 6. Compression ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>
