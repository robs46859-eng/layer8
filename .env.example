APP_NAME=enterprise-ai-routing-proxy
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8000
BACKEND_MODE=self_hosted
DATABASE_URL=postgresql+psycopg://proxy_user:proxy_pass@localhost:5432/ai_proxy
REDIS_URL=redis://localhost:6379/0
S3_BUCKET=ai-proxy-audit
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=testtesttest
AWS_ENDPOINT_URL=http://localhost:9324
S3_ENDPOINT_URL=http://localhost:9000
AUDIT_QUEUE_URL=http://localhost:9324/queue/ai-proxy-audit
DEFAULT_PROVIDER=mock
ENABLE_PROMPT_LOGGING=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120
PLUGIN_TIMEOUT_MS=100
CACHE_TTL_SECONDS=300
CACHE_S3_THRESHOLD_BYTES=4096
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=5
STARTUP_CHECKS_ENABLED=true
STARTUP_CHECKS_STRICT=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ADMIN_API_TOKEN=change-admin-token
DEV_API_KEY_PREFIX=ak_live_demo
DEV_API_KEY_SECRET=change-me-now
PUBLIC_WEB_URL=https://salti8.com
PUBLIC_API_URL=https://api.salti8.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PORTAL_CONFIGURATION_ID=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://salti8.com

# Hostinger static web build
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=https://api.salti8.com
NEXT_PUBLIC_TEAM_PRICE_LABEL=$99/mo
NEXT_PUBLIC_BUSINESS_PRICE_LABEL=$299/mo
