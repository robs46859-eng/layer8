APP_NAME=salti8-api
ENVIRONMENT=production
BACKEND_MODE=self_hosted
HOST=0.0.0.0

AWS_REGION=us-east-1
S3_BUCKET=salti8-audit-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AUDIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/268054298018/salti8-audit
S3_ENDPOINT_URL=
AWS_ENDPOINT_URL=

PUBLIC_WEB_URL=https://salti8.com
PUBLIC_API_URL=https://api.salti8.com
CORS_ALLOWED_ORIGINS=https://salti8.com,https://www.salti8.com

CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=https://salti8.com,https://www.salti8.com
SELF_SERVICE_SIGNUP_ENABLED=true

ADMIN_API_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PORTAL_CONFIGURATION_ID=
BILLING_PAST_DUE_GRACE_DAYS=3

OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_PROVIDER=openai

STARTUP_CHECKS_ENABLED=true
STARTUP_CHECKS_STRICT=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120
ENABLE_PROMPT_LOGGING=false
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=5

NEXT_PUBLIC_SITE_URL=https://salti8.com
NEXT_PUBLIC_API_URL=https://api.salti8.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_TEAM_PRICE_LABEL=$99/mo
NEXT_PUBLIC_BUSINESS_PRICE_LABEL=$299/mo
